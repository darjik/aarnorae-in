{% doc %}
  Adds store search and breadcrumb structured data for SEO and answer engines.
{% enddoc %}

{%- liquid
  assign home_url = request.origin
  assign current_url = canonical_url | default: request.origin
  assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'
  assign brand_name = 'AARNORAE'
  assign brand_facebook_url = 'https://www.facebook.com/profile.php?id=61594119323146'
  assign brand_instagram_url = 'https://www.instagram.com/aarnorae.parfum/'
  assign brand_threads_url = 'https://www.threads.com/@aarnorae.parfum'
  assign breadcrumb_collection_title = collection.title
  if request.page_type == 'collection' and collection.handle == 'all'
    assign breadcrumb_collection_title = 'All Fragrances'
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ home_url | append: '#organization' | json }},
    "name": {{ brand_name | json }},
    "alternateName": ["AARNORAE Parfums", "AARNORAE Perfumes"],
    "url": {{ home_url | json }},
    "sameAs": [
      {{ brand_facebook_url | json }},
      {{ brand_instagram_url | json }},
      {{ brand_threads_url | json }}
    ]{% if settings.logo != blank %},
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
    }{% endif %}
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ home_url | append: '#website' | json }},
    "name": {{ brand_name | json }},
    "alternateName": ["AARNORAE Parfums", "AARNORAE Perfumes", "aarnorae.in"],
    "url": {{ home_url | json }},
    "publisher": {
      "@id": {{ home_url | append: '#organization' | json }}
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ search_target | json }}
      },
      "query-input": "required name=search_term_string"
    }
  }
</script>

{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": {{ current_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ home_url | json }}
        }
        {%- if request.page_type == 'product' -%}
          {%- assign breadcrumb_collection = product.collections | first -%}
          {%- if breadcrumb_collection != blank -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ breadcrumb_collection.title | json }},
              "item": {{ request.origin | append: breadcrumb_collection.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ current_url | json }}
            }
          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ current_url | json }}
            }
          {%- endif -%}
        {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ breadcrumb_collection_title | json }},
            "item": {{ current_url | json }}
          }
        {%- elsif request.page_type == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ current_url | json }}
          }
        {%- elsif request.page_type == 'article' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ request.origin | append: blog.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ current_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
