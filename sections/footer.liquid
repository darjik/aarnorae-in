

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  footer .footer-content {
    padding-block: 64px 48px;
  }

  footer .footer-content > :first-child h2 {
    margin: 0 0 12px;
    color: var(--aarnorae-champagne-gold);
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  footer .footer-content > :first-child p {
    max-width: 24rem;
    margin: 0;
    color: rgb(251 249 245 / 70%);
    font-size: 0.9375rem;
    line-height: 1.5rem;
  }

  footer .footer-content .menu__heading,
  footer .footer-content > :last-child h2 {
    margin: 0 0 20px;
    color: var(--aarnorae-champagne-gold);
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  footer .footer-content .menu__list,
  footer .footer-content .menu__list-item {
    gap: 10px;
  }

  footer .footer-content .menu__item,
  footer .footer-content .menu__list-item a {
    color: rgb(251 249 245 / 70%);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  footer .footer-content > :last-child p {
    margin: 0;
    color: rgb(251 249 245 / 70%);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  footer .footer-content a {
    text-underline-offset: 4px;
  }

  footer .footer-content a:hover {
    color: var(--aarnorae-champagne-gold);
  }

  footer .email-signup__input-group,
  footer input,
  footer button {
    border-radius: 0;
  }

  footer .footer-content .email-signup__input.paragraph,
  footer .footer-content .email-signup__button--text.paragraph {
    min-height: 48px;
    padding: 0 16px;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  footer .footer-content .email-signup__button--text.paragraph {
    padding-inline: 24px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  footer .footer-content > :first-child .social-icons__wrapper {
    gap: 12px;
    margin-top: 24px;
  }

  footer .footer-content > :first-child .social-icons__icon-wrapper {
    width: 40px;
    height: 40px;
    border: 1px solid rgb(168 117 65 / 40%);
    color: var(--aarnorae-champagne-gold);
  }

  footer .footer-content > :first-child .social-icons__icon {
    width: 18px;
    height: 18px;
  }

  .aarnorae-footer-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    padding-block: 14px;
    color: inherit;
    font-size: 0.8125rem;
  }

  .aarnorae-footer-contact strong {
    flex-basis: 100%;
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 400;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 48px;
      row-gap: 48px;
    }

    .footer-content > :nth-child(1) { grid-column: span 4; }
    .footer-content > :nth-child(2) { grid-column: span 2; }
    .footer-content > :nth-child(3) { grid-column: span 2; }
    .footer-content > :nth-child(4) { grid-column: span 4; }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
