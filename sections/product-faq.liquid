{% liquid
  assign product_faqs = product.metafields.custom.product_faqs.value
  assign faq_count = product_faqs.count
%}

{% if faq_count > 0 %}
  {% if section.settings.background_color != blank %}
    {% render 'contrast-override',
      background_color: section.settings.background_color,
      text_color: section.settings.text_color,
      section_id: section.id
    %}
  {% endif %}

  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <section
    class="product-faq section section--page-width{% if section.settings.background_color != blank or section.settings.text_color != blank %} color-custom-{{ section.id }}{% endif %}"
    aria-labelledby="ProductFaqHeading-{{ section.id }}"
  >
    <div class="product-faq__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="product-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="ProductFaqHeading-{{ section.id }}" class="product-faq__heading">
        {{ section.settings.heading | escape }}
      </h2>
      {% if section.settings.intro != blank %}
        <div class="product-faq__copy rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="product-faq__items">
      {% for faq in product_faqs %}
        {% assign question = faq.question.value | strip %}
        {% assign answer_text = faq.answer | metafield_tag | strip_html | strip %}
        {% if question != blank and answer_text != blank %}
          <details class="product-faq__item">
            <summary class="product-faq__question">
              <span>{{ question | escape }}</span>
              <span class="product-faq__icon" aria-hidden="true">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="product-faq__answer rte">
              {{ faq.answer | metafield_tag }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for faq in product_faqs %}
          {
            "@type": "Question",
            "name": {{ faq.question.value | strip | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq.answer | metafield_tag | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .product-faq {
    display: grid;
    grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: 4.5rem;
  }

  .product-faq__intro {
    align-self: start;
  }

  .product-faq__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .product-faq__heading {
    margin: 0;
    font-size: 2rem;
    line-height: 1.15;
  }

  .product-faq__copy {
    max-width: 32rem;
    margin-top: 1rem;
  }

  .product-faq__items {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 20%);
  }

  .product-faq__item {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 20%);
  }

  .product-faq__question {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    gap: 1.5rem;
    align-items: center;
    min-height: 4rem;
    padding-block: 1rem;
    cursor: pointer;
    font-weight: 650;
    list-style: none;
  }

  .product-faq__question::-webkit-details-marker {
    display: none;
  }

  .product-faq__icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 180ms ease;
  }

  .product-faq__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-faq__item[open] .product-faq__icon {
    transform: rotate(45deg);
  }

  .product-faq__answer {
    max-width: 44rem;
    padding: 0 3rem 1.5rem 0;
  }

  @media screen and (max-width: 749px) {
    .product-faq {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-block: 3rem;
    }

    .product-faq__heading {
      font-size: 1.75rem;
    }

    .product-faq__answer {
      padding-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product FAQ",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Before you choose"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Practical details about this fragrance, from performance to the best way to wear it.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F0EDE4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#004741"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ"
    }
  ]
}
{% endschema %}
