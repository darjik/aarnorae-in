{% doc %}
  @prompt
    ABOUT US
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-about-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 440px;
  }

  .ai-about-{{ ai_gen_id }}__media {
    position: relative;
    min-height: 440px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-about-{{ ai_gen_id }}__media img,
  .ai-about-{{ ai_gen_id }}__media-placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-about-{{ ai_gen_id }}__media-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.muted_color }};
  }

  .ai-about-{{ ai_gen_id }}__media-placeholder svg {
    max-width: 70%;
    max-height: 70%;
  }

  .ai-about-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px clamp(28px, 7vw, 96px);
  }

  .ai-about-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 18px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.accent_font.family }}, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-about-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .ai-about-{{ ai_gen_id }}__text {
    max-width: 560px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 16px;
    line-height: 1.8;
  }

  .ai-about-{{ ai_gen_id }}__text p {
    margin: 0 0 16px;
  }

  .ai-about-{{ ai_gen_id }}__text p:last-child {
    margin-bottom: 0;
  }

  .ai-about-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 30px;
    padding: 13px 22px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: 14px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-about-{{ ai_gen_id }}__link:hover {
    opacity: 0.8;
  }

  .ai-about-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-about-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
    }

    .ai-about-{{ ai_gen_id }}__media {
      min-height: 300px;
      order: 1;
    }

    .ai-about-{{ ai_gen_id }}__content {
      order: 2;
      padding: 44px 28px 52px;
    }
  }
{% endstyle %}

<div class="ai-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-about-{{ ai_gen_id }}__inner">
    <div class="ai-about-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-about-{{ ai_gen_id }}__media-placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    <div class="ai-about-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-about-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-about-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.body != blank %}
        <div class="ai-about-{{ ai_gen_id }}__text">{{ block.settings.body }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-about-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About us",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The art of wearing a feeling"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>At Aarnorae Parfums, we create refined fragrances inspired by memory, nature and the quiet rituals that make every day extraordinary.</p><p>Each scent is thoughtfully composed to become part of your story.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover our fragrances"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "inter_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "font_picker",
      "id": "accent_font",
      "label": "Accent font",
      "default": "inter_n5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F0EDE4"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#E4DED1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#004741"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#004741"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5E4323"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5E625B"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#004741"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "About us"
    }
  ],
  "tag": null,
  "class": "about-us-block"
}
{% endschema %}