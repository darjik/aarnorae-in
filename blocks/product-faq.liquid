{% doc %}
  Renders product-specific FAQ entries from the custom.product_faqs metafield.
{% enddoc %}

{% liquid
  assign product_faqs = product.metafields.custom.product_faqs.value
  assign faq_count = product_faqs.count
%}

{% if faq_count > 0 %}
  <div class="product-faq-compact" {{ block.shopify_attributes }}>
    <div class="product-faq-compact__header">
      <h2 class="product-faq-compact__heading">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.intro != blank %}
        <div class="product-faq-compact__intro rte">{{ block.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="product-faq-compact__items">
      {% for faq in product_faqs %}
        {% assign question = faq.question.value | strip %}
        {% assign answer_text = faq.answer | metafield_tag | strip_html | strip %}
        {% if question != blank and answer_text != blank %}
          <details class="product-faq-compact__item">
            <summary class="product-faq-compact__question">
              <span>{{ question | escape }}</span>
              <span class="product-faq-compact__icon" aria-hidden="true">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="product-faq-compact__answer rte">
              {{ faq.answer | metafield_tag }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for faq in product_faqs %}
          {
            "@type": "Question",
            "name": {{ faq.question.value | strip | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq.answer | metafield_tag | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .product-faq-compact {
    width: 100%;
    margin-top: 0.5rem;
  }

  .product-faq-compact__header {
    margin-bottom: 0.75rem;
  }

  .product-faq-compact__heading {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .product-faq-compact__intro {
    margin: 0.35rem 0 0;
    color: rgb(var(--color-foreground-rgb) / 72%);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .product-faq-compact__intro p {
    margin: 0;
  }

  .product-faq-compact__items {
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 18%);
  }

  .product-faq-compact__item + .product-faq-compact__item {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 18%);
  }

  .product-faq-compact__question {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    gap: 1rem;
    align-items: center;
    min-height: 3.25rem;
    padding-block: 0.75rem;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.4;
    list-style: none;
  }

  .product-faq-compact__question::-webkit-details-marker {
    display: none;
  }

  .product-faq-compact__question:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .product-faq-compact__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    transition: transform 180ms ease;
  }

  .product-faq-compact__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-faq-compact__item[open] .product-faq-compact__icon {
    transform: rotate(45deg);
  }

  .product-faq-compact__answer {
    padding: 0 2rem 1rem 0;
    color: rgb(var(--color-foreground-rgb) / 82%);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .product-faq-compact__answer > :first-child {
    margin-top: 0;
  }

  .product-faq-compact__answer > :last-child {
    margin-bottom: 0;
  }

  @media (hover: hover) {
    .product-faq-compact__question:hover {
      color: rgb(var(--color-foreground-rgb) / 72%);
    }
  }

  @media screen and (max-width: 749px) {
    .product-faq-compact {
      margin-top: 0.25rem;
    }

    .product-faq-compact__question {
      min-height: 3.5rem;
      font-size: 1rem;
    }

    .product-faq-compact__answer {
      padding-right: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.faq_section",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Good to know"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:settings.text",
      "default": "<p>Quick answers about this fragrance before you choose.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_section",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
