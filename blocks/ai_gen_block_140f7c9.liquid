{% doc %}
  @prompt
    Create a full-width hero banner slideshow/carousel section for a luxury perfume brand. It should display multiple images one at a time with smooth auto-sliding transitions (every 4-5 seconds). Include previous/next arrow navigation buttons and dot indicators at the bottom. The carousel should be full-width, approximately 600-700px tall on desktop, and responsive on mobile. Support for adding images and optional overlay text (heading and subheading) per slide. Clean, minimal, elegant design that suits a premium fragrance brand aesthetic., Now this shows square image. I need same format as hero banner image with aspect ratio of 16:9 which should be view properly in mobile as well.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: block;
  }

  .ai-hero-carousel__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-hero-carousel__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_duration }}s ease-in-out;
    pointer-events: none;
  }

  .ai-hero-carousel__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-hero-carousel__slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-carousel__slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-carousel__slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_alignment_vertical }};
    align-items: {{ block.settings.content_alignment_horizontal }};
    padding: 40px;
    text-align: {{ block.settings.text_align }};
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}),
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }})
    );
  }

  .ai-hero-carousel__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
  }

  .ai-hero-carousel__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .ai-hero-carousel__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    font-weight: 400;
    opacity: 0.9;
  }

  .ai-hero-carousel__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_icon_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.3s ease, transform 0.3s ease;
    opacity: {{ block.settings.nav_button_opacity | divided_by: 100.0 }};
  }

  .ai-hero-carousel__nav-button-{{ ai_gen_id }}:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .ai-hero-carousel__nav-button--prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-hero-carousel__nav-button--next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-hero-carousel__nav-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.5);
    height: calc({{ block.settings.nav_button_size }}px * 0.5);
  }

  .ai-hero-carousel__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  .ai-hero-carousel__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    opacity: {{ block.settings.dot_inactive_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  .ai-hero-carousel__dot-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-hero-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  @media screen and (max-width: 749px) {
    .ai-hero-carousel__overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-hero-carousel__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-hero-carousel__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.7);
    }

    .ai-hero-carousel__nav-button-{{ ai_gen_id }} {
      width: calc({{ block.settings.nav_button_size }}px * 0.7);
      height: calc({{ block.settings.nav_button_size }}px * 0.7);
    }

    .ai-hero-carousel__nav-button--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-hero-carousel__nav-button--next-{{ ai_gen_id }} {
      right: 10px;
    }
  }
{% endstyle %}

<hero-carousel-{{ ai_gen_id }}
  class="ai-hero-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-carousel__slides-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign slide_image_key = 'slide_' | append: i | append: '_image'
        assign slide_heading_key = 'slide_' | append: i | append: '_heading'
        assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign slide_image = block.settings[slide_image_key]
        assign slide_heading = block.settings[slide_heading_key]
        assign slide_subheading = block.settings[slide_subheading_key]
      %}

      {% if slide_enabled %}
        <div
          class="ai-hero-carousel__slide-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
          data-slide-index="{{ forloop.index }}"
        >
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2400 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="ai-hero-carousel__slide-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-hero-carousel__slide-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              <div class="ai-hero-carousel__empty-state-{{ ai_gen_id }}">
                Add an image for slide {{ i }}
              </div>
            </div>
          {% endif %}

          {% if slide_heading != blank or slide_subheading != blank %}
            <div class="ai-hero-carousel__overlay-{{ ai_gen_id }}">
              <div class="ai-hero-carousel__content-{{ ai_gen_id }}">
                {% if slide_heading != blank %}
                  <h2 class="ai-hero-carousel__heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
                {% endif %}
                {% if slide_subheading != blank %}
                  <p class="ai-hero-carousel__subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.show_navigation %}
    <button
      class="ai-hero-carousel__nav-button-{{ ai_gen_id }} ai-hero-carousel__nav-button--prev-{{ ai_gen_id }}"
      aria-label="Previous slide"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      class="ai-hero-carousel__nav-button-{{ ai_gen_id }} ai-hero-carousel__nav-button--next-{{ ai_gen_id }}"
      aria-label="Next slide"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-hero-carousel__dots-{{ ai_gen_id }}"></div>
  {% endif %}
</hero-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-hero-carousel__slide-{{ ai_gen_id }}'));
        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.prevButton = this.querySelector('.ai-hero-carousel__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-hero-carousel__nav-button--next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-hero-carousel__dots-{{ ai_gen_id }}');

        this.setupNavigation();
        this.setupDots();
        this.setupAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }

      setupNavigation() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }
      }

      setupDots() {
        if (!this.dotsContainer) return;

        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-hero-carousel__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          dot.setAttribute('type', 'button');
          if (index === 0) {
            dot.classList.add('active');
          }
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupAutoplay() {
        const autoplay = this.dataset.autoplay === 'true';
        const interval = parseInt(this.dataset.interval) * 1000;

        if (autoplay && this.totalSlides > 1) {
          this.autoplayInterval = setInterval(() => {
            this.nextSlide();
          }, interval);

          this.addEventListener('mouseenter', () => {
            if (this.autoplayInterval) {
              clearInterval(this.autoplayInterval);
            }
          });

          this.addEventListener('mouseleave', () => {
            if (autoplay) {
              this.autoplayInterval = setInterval(() => {
                this.nextSlide();
              }, interval);
            }
          });
        }
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        this.currentSlide = index;
        this.slides[this.currentSlide].classList.add('active');
        this.updateDots();
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.totalSlides;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.goToSlide(prevIndex);
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-hero-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('hero-carousel-{{ ai_gen_id }}', HeroCarousel{{ ai_gen_id }});
  })();
</script>

